---
import TypingFont from "../../components/01-Atoms/TypingFont.astro";
import Window from "../../components/01-Atoms/Window.astro";
import Layout from "../../components/04-layouts/Layout.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "fr" } }];
}

const { lang } = Astro.params;
---

<Layout>
  <div class="h-screen bg-amber-400 md:mt-16">
    <Window
      class="h-[20rem] sm:w-7/12 md:ml-24 md:h-[35rem]"
      title="Welcome"
      color="#00fee8"
      ><TypingFont
        class="text-[3.5rem] md:text-9xl"
        text="Laurent-Philippe Caron"
      /></Window
    >
    <Window
      class="mt-5 h-32 sm:-mt-20 sm:mr-5 sm:ml-auto sm:w-7/12 md:h-52"
      title="Job"
      color="pink"
    >
      <p class:list={["text-3xl", "md:text-6xl"]}>Programmeur front-end</p>
    </Window>
  </div>
</Layout>

<style lang="scss">
  i {
    @apply flex items-center justify-center;
  }
</style>
