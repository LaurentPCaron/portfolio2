---
import TypingFont from "../../components/01-Atoms/TypingFont.astro";
import Window from "../../components/01-Atoms/Window.astro";
import Layout from "../../components/04-layouts/Layout.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "fr" } }];
}

const { lang } = Astro.params;
---

<Layout>
  <div class="mt-60 h-screen">
    <Window class="mr-10 ml-40" title="Welcome" color="#00fee8"
      ><TypingFont text="Laurent‑Philippe Caron" /></Window
    >
    <Window
      class="mr-16 ml-auto h-72 w-[600px] -translate-y-40"
      title="Titre"
      color="pink"
    >
      <p class="text-5xl">
        Lorem ipsum dolor sit amet consectetur adipisicing elit.
      </p>
    </Window>
  </div>
</Layout>

<style lang="scss">
  i {
    @apply flex items-center justify-center;
  }
</style>
